# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# Generate both with: openssl rand -base64 32
JWT_SECRET_BASE64=
EVIDENCE_MASTER_KEY_BASE64=

# Optional, comma-separated: retired master keys, kept only during a rotation window so
# not-yet-rotated cases can still be unwrapped. Leave blank unless you're mid-rotation - see
# README "Per-case encryption key rotation".
EVIDENCE_PREVIOUS_MASTER_KEYS_BASE64=

# Only needed for docker-compose local Postgres
POSTGRES_PASSWORD=changeme_dev_only

# REQUIRED for a usable deployment: public registration can never create ADMIN accounts
# (see the privilege-escalation fix), so this is the only way the very first admin gets created.
# Leave any of these blank to skip bootstrap - you'll then need to insert an admin directly into
# the DB, or promote later via another already-existing admin.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Set to false in a real deployment - true seeds a demo case/evidence/user on first run so the
# app isn't empty for reviewers.
SEED_DEMO_DATA=true

# Per-user storage quota in bytes. Default is 5GB (5368709120).
EVIDENCE_USER_QUOTA_BYTES=5368709120

# Optional malware scanning via an external ClamAV daemon (clamd). See README for how to run one
# via docker-compose or directly on a Linux host. Leave CLAMAV_ENABLED=false to skip scanning
# entirely (uploads proceed unscanned) if you don't want to run ClamAV.
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Rate limiting backend: "memory" (default, per-instance, no extra infra) or "redis" (shared
# across every instance behind a load balancer - see README "Distributed rate limiting").
# REDIS_HOST/_PORT/_PASSWORD are only used when RATE_LIMIT_BACKEND=redis.
RATE_LIMIT_BACKEND=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
